# Copy to ".env" and fill in your key(s).
# An OPENAI_API_KEY is required (it powers retrieval embeddings). If an
# ANTHROPIC_API_KEY is also present, Claude is used for the answers; otherwise GPT.
# Placeholder values like the ones below are treated as "not set".

# OpenAI: embeddings for retrieval, and GPT for answer synthesis. (Required.)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic: Claude for answer synthesis (preferred when set). (Optional.)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional overrides ---
# RESEARCH_CLAUDE_MODEL=claude-sonnet-5
# RESEARCH_OPENAI_MODEL=gpt-4o-mini
# RESEARCH_EMBED_MODEL=text-embedding-3-small
